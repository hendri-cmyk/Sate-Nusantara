        <div class="absolute inset-0 bg-neutral-950/60 backdrop-blur-sm transition-opacity" onclick="toggleCartDrawer()"></div>
        <div class="absolute inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col justify-between transform transition-transform duration-300">
                <!-- Header -->
                <div class="p-6 border-b border-neutral-100 flex items-center justify-between bg-amber-50/50">
                    <div class="flex items-center gap-2">
