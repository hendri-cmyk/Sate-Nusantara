                <!-- Add to cart action -->
                <button onclick="addModalItemToCart()" class="w-full py-4 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold shadow-lg shadow-amber-600/30 transition-all flex items-center justify-center gap-2">
                    <i data-lucide="shopping-bag" class="w-5 h-5"></i> Masukkan ke Keranjang - <span id="modal-total-price">Rp 0</span>
