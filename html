                        <label class="border border-neutral-200 rounded-xl p-3 flex items-center gap-2 cursor-pointer hover:border-amber-500 has-[:checked]:border-amber-600 has-[:checked]:bg-amber-50">
                            <input type="radio" name="payment" value="COD" class="text-amber-600 focus:ring-amber-500">
