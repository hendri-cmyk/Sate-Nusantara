            <button onclick="closeSuccessModal()" class="w-full py-3.5 rounded-2xl bg-amber-600 hover:bg-amber-700 text-white font-bold shadow-md transition-all">
                Kembali ke Beranda
            </button>
        </div>
    </div>

    <!-- JAVASCRIPT APPLICATION LOGIC -->
    <script>
        // Menu Data
        const menuItems = [
            {
                id: 1,
                name: "Sate Ayam Madura Asli",
                category: "sate-ayam",
                price: 32000,
                rating: 4.9,
                reviews: 128,
                desc: "Sate daging ayam pilihan dengan bumbu kacang kental khas Madura gurih manis, ditaburi bawang goreng renyah.",
                image: "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&q=80&w=600"
            },
            {
                id: 2,
                name: "Sate Kambing Muda Empuk",
                category: "sate-kambing",
                price: 55000,
                rating: 4.9,
                reviews: 215,
                desc: "Daging kambing muda pilihan dijamin empuk tanpa bau prengus, dibakar dengan kecap manis spesial dan irisan cabai rawit segar.",
                image: "https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&q=80&w=600"
            },
            {
                id: 3,
                name: "Sate Padang Daging Sapi",
