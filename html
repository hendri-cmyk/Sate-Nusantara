                image: "https://images.unsplash.com/photo-1529193591184-b1d58069ecdd?auto=format&fit=crop&q=80&w=600"
            },
            {
                id: 4,
                name: "Sate Taichan Juicy",
                category: "sate-ayam",
                price: 30000,
                rating: 4.7,
                reviews: 110,
                desc: "Sate ayam bakar putih bersih tanpa bumbu kacang, disajikan dengan sambal rawit jeruk limau yang pedas segar menggigit.",
                image: "https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&q=80&w=600"
            },
            {
                id: 5,
                name: "Sate Kulit Krispi Bakar",
                category: "sate-nusantara",
                price: 25000,
                rating: 4.8,
                reviews: 82,
                desc: "Kulit ayam gurih pilihan dibumbui rempah rahasia lalu dibakar garing kecoklatan, nikmat disantap selagi hangat.",
                image: "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&q=80&w=600"
            },
            {
                id: 6,
                name: "Es Teh Manis Melati",
                category: "minuman",
                price: 6000,
                rating: 5.0,
                reviews: 300,
                desc: "Teh pilihan beraroma melati segar disajikan dingin menyegarkan penawar dahaga.",
                image: "https://images.unsplash.com/photo-1556679343-c7306c1976bc?auto=format&fit=crop&q=80&w=600"
            },
            {
                id: 7,
                name: "Es Jeruk Peras Asli",
                category: "minuman",
                price: 10000,
                rating: 4.9,
                reviews: 190,
                desc: "Perasan jeruk segar asli kaya vitamin C dipadu es batu kristal yang menyegarkan.",
                image: "https://images.unsplash.com/photo-1613478223719-2ab802602423?auto=format&fit=crop&q=80&w=600"
            },
            {
                id: 8,
                name: "Sate Sapi Maranggi",
                category: "sate-nusantara",
                price: 48000,
                rating: 4.9,
                reviews: 140,
                desc: "Sate sapi khas Purwakarta dengan marinasi ketumbar dan asam jawa yang meresap sempurna ke dalam serat daging.",
                image: "https://images.unsplash.com/photo-1603048588665-791ca8aea617?auto=format&fit=crop&q=80&w=600"
            }
        ];

        // State Management
        let cart = [];
        let currentModalItem = null;
        let currentModalQty = 1;
        let selectedSpicy = 'Sedang';
        let selectedCompanion = 'Lontong';

        // Utility Format IDR
        function formatIDR(amount) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(amount);
        }

        // Initialize Lucide Icons
        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            renderMenu('all');
            updateCartBadge();
        });

        // Render Menu Catalog
        function renderMenu(category) {
            const grid = document.getElementById('menu-grid');
            grid.innerHTML = '';

            const filtered = category === 'all' ? menuItems : menuItems.filter(item => item.category === category);

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl border border-amber-100 transition-all duration-300 flex flex-col justify-between group';
                card.innerHTML = `
                    <div class="relative h-52 overflow-hidden bg-neutral-100">
                        <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://placehold.co/600x400/78350f/fff?text=Sate'">
                        <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-full text-xs font-bold text-amber-900 flex items-center gap-1 shadow-md">
                            <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-500 text-amber-500"></i> ${item.rating} (${item.reviews})
                        </div>
                    </div>
                    <div class="p-6 space-y-4 flex-1 flex flex-col justify-between">
                        <div class="space-y-2">
                            <h3 class="text-xl font-bold text-neutral-900 group-hover:text-amber-700 transition-colors">${item.name}</h3>
                            <p class="text-sm text-neutral-600 line-clamp-2">${item.desc}</p>
                        </div>
                        <div class="flex items-center justify-between pt-4 border-t border-neutral-100">
                            <div>
                                <span class="text-xs text-neutral-400 block font-medium">Harga</span>
                                <span class="text-lg font-extrabold text-amber-800">${formatIDR(item.price)}</span>
                            </div>
                            <button onclick="openDetailModal(${item.id})" class="px-4 py-2.5 rounded-xl bg-amber-100 hover:bg-amber-600 text-amber-900 hover:text-white font-bold text-sm transition-all shadow-sm flex items-center gap-1.5">
                                <i data-lucide="plus" class="w-4 h-4"></i> Pilih Pesanan
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
            lucide.createIcons();
        }

        // Filter Menu Categories
        function filterMenu(category) {
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.classList.remove('bg-amber-600', 'text-white', 'shadow-md', 'shadow-amber-600/20');
                btn.classList.add('bg-white', 'text-neutral-700', 'border', 'border-amber-200');
            });
            event.currentTarget.classList.remove('bg-white', 'text-neutral-700', 'border', 'border-amber-200');
            event.currentTarget.classList.add('bg-amber-600', 'text-white', 'shadow-md', 'shadow-amber-600/20');
            renderMenu(category);
        }

        // Open Detail Modal
        function openDetailModal(id) {
            currentModalItem = menuItems.find(i => i.id === id);
            currentModalQty = 1;
            selectedSpicy = 'Sedang';
            selectedCompanion = 'Lontong';

            document.getElementById('modal-img').src = currentModalItem.image;
            document.getElementById('modal-category').innerText = currentModalItem.category.toUpperCase().replace('-', ' ');
            document.getElementById('modal-name').innerText = currentModalItem.name;
            document.getElementById('modal-desc').innerText = currentModalItem.desc;
            document.getElementById('modal-price').innerText = formatIDR(currentModalItem.price);
            document.getElementById('modal-qty').innerText = currentModalQty;

            // Reset buttons UI
            updateOptionUI('spicy', 'Sedang');
            updateOptionUI('companion', 'Lontong');
            updateModalTotalPrice();

            const modal = document.getElementById('detail-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                document.getElementById('detail-modal-box').classList.remove('scale-95');
                document.getElementById('detail-modal-box').classList.add('scale-100');
            }, 10);
        }

        function closeDetailModal() {
            const modal = document.getElementById('detail-modal');
            document.getElementById('detail-modal-box').classList.remove('scale-100');
            document.getElementById('detail-modal-box').classList.add('scale-95');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 200);
        }

        function selectOption(type, val) {
            if (type === 'spicy') {
                selectedSpicy = val;
                updateOptionUI('spicy', val);
            } else if (type === 'companion') {
                selectedCompanion = val;
                updateOptionUI('companion', val);
            }
        }

        function updateOptionUI(type, activeVal) {
            const selector = type === 'spicy' ? '#spicy-options button' : '#companion-options button';
            document.querySelectorAll(selector).forEach(btn => {
                if (btn.innerText.trim() === activeVal) {
                    btn.className = type === 'spicy' ? 'spicy-btn active py-2 text-xs font-semibold rounded-xl border-2 border-amber-600 bg-amber-50 text-amber-900 transition-all' : 'companion-btn active py-2 text-xs font-semibold rounded-xl border-2 border-amber-600 bg-amber-50 text-amber-900 transition-all';
                } else {
                    btn.className = type === 'spicy' ? 'spicy-btn py-2 text-xs font-semibold rounded-xl border border-neutral-200 hover:border-amber-500 text-neutral-700 transition-all' : 'companion-btn py-2 text-xs font-semibold rounded-xl border border-neutral-200 hover:border-amber-500 text-neutral-700 transition-all';
                }
            });
        }

        function adjustModalQty(change) {
            currentModalQty += change;
            if (currentModalQty < 1) currentModalQty = 1;
            document.getElementById('modal-qty').innerText = currentModalQty;
            updateModalTotalPrice();
        }

        function updateModalTotalPrice() {
            const total = currentModalItem.price * currentModalQty;
            document.getElementById('modal-total-price').innerText = formatIDR(total);
        }

        function addModalItemToCart() {
            const cartItem = {
                uniqueId: Date.now(),
                id: currentModalItem.id,
                name: currentModalItem.name,
                price: currentModalItem.price,
                image: currentModalItem.image,
                qty: currentModalQty,
                spicy: currentModalItem.category === 'minuman' ? null : selectedSpicy,
                companion: currentModalItem.category === 'minuman' ? null : selectedCompanion
            };
            cart.push(cartItem);
            updateCartBadge();
            closeDetailModal();
            showToast(`Berhasil menambahkan ${currentModalItem.name} ke keranjang!`);
        }

        // Toast Notification System
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'bg-neutral-900 text-white text-xs font-semibold px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2 border border-neutral-800 pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300';
            toast.innerHTML = `<i data-lucide="check-circle" class="w-4 h-4 text-amber-500"></i> ${message}`;
            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Cart Drawer Control
        function toggleCartDrawer() {
            const drawer = document.getElementById('cart-drawer');
            if (drawer.classList.contains('hidden')) {
                drawer.classList.remove('hidden');
                renderCartItems();
            } else {
                drawer.classList.add('hidden');
            }
        }

        function updateCartBadge() {
            const badge = document.getElementById('cart-badge');
            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            badge.innerText = totalQty;
            if (totalQty > 0) {
                badge.classList.remove('scale-0');
                badge.classList.add('scale-100');
            } else {
                badge.classList.remove('scale-100');
                badge.classList.add('scale-0');
            }
        }

        function renderCartItems() {
            const container = document.getElementById('cart-items-container');
            container.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-16 space-y-3">
                        <div class="w-16 h-16 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto">
                            <i data-lucide="shopping-bag" class="w-8 h-8"></i>
                        </div>
                        <p class="text-neutral-700 font-bold">Keranjang Anda masih kosong</p>
                        <p class="text-xs text-neutral-400">Yuk pilih sate favoritmu sekarang!</p>
                    </div>
                `;
                document.getElementById('cart-subtotal').innerText = formatIDR(0);
                document.getElementById('cart-total').innerText = formatIDR(0);
                document.getElementById('checkout-btn').disabled = true;
                lucide.createIcons();
                return;
            }

            document.getElementById('checkout-btn').disabled = false;
            let subtotal = 0;

            cart.forEach((item, index) => {
                const itemTotal = item.price * item.qty;
                subtotal += itemTotal;

                const div = document.createElement('div');
                div.className = 'flex gap-4 pt-4 first:pt-0';
                div.innerHTML = `
                    <img src="${item.image}" alt="${item.name}" class="w-20 h-20 rounded-2xl object-cover border border-amber-100 shrink-0">
                    <div class="flex-1 space-y-1">
                        <div class="flex justify-between">
                            <h4 class="font-bold text-sm text-neutral-900">${item.name}</h4>
                            <button onclick="removeCartItem(${index})" class="text-neutral-400 hover:text-red-500 transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                        ${item.spicy ? `<p class="text-[11px] text-amber-700 font-medium">Pedas: ${item.spicy} | Pendamping: ${item.companion}</p>` : ''}
                        <div class="flex items-center justify-between pt-2">
                            <div class="flex items-center gap-2 border border-neutral-200 rounded-lg px-2 py-0.5">
                                <button onclick="updateCartQty(${index}, -1)" class="text-neutral-500 font-bold hover:text-neutral-800">-</button>
                                <span class="text-xs font-bold w-4 text-center">${item.qty}</span>
                                <button onclick="updateCartQty(${index}, 1)" class="text-neutral-500 font-bold hover:text-neutral-800">+</button>
                            </div>
                            <span class="text-sm font-extrabold text-amber-800">${formatIDR(itemTotal)}</span>
                        </div>
                    </div>
                `;
                container.appendChild(div);
            });

            document.getElementById('cart-subtotal').innerText = formatIDR(subtotal);
            document.getElementById('cart-total').innerText = formatIDR(subtotal + 15000);
            lucide.createIcons();
        }

        function updateCartQty(index, change) {
            cart[index].qty += change;
            if (cart[index].qty <= 0) {
                cart.splice(index, 1);
            }
            updateCartBadge();
            renderCartItems();
        }

        function removeCartItem(index) {
            cart.splice(index, 1);
            updateCartBadge();
            renderCartItems();
        }

        // Checkout & Simulation Modals
        function openCheckoutModal() {
            toggleCartDrawer();
            const modal = document.getElementById('checkout-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCheckoutModal() {
            const modal = document.getElementById('checkout-modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        function submitOrder(e) {
            e.preventDefault();
            const name = document.getElementById('cust-name').value;
            const phone = document.getElementById('cust-phone').value;
            const address = document.getElementById('cust-address').value;
            const payment = document.querySelector('input[name="payment"]:checked').value;

            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const total = subtotal + 15000;

            const summaryBox = document.getElementById('order-summary-box');
            summaryBox.innerHTML = `
                <p><strong>Nama Pemesan:</strong> ${name}</p>
                <p><strong>Telepon:</strong> ${phone}</p>
                <p><strong>Alamat:</strong> ${address}</p>
                <p><strong>Pembayaran:</strong> ${payment}</p>
                <hr class="border-amber-200 my-1">
                <p><strong>Total Item:</strong> ${cart.reduce((s, i) => s + i.qty, 0)} Porsi</p>
                <p><strong>Total Tagihan:</strong> <span class="text-amber-700 font-extrabold">${formatIDR(total)}</span></p>
            `;

            closeCheckoutModal();
            cart = [];
            updateCartBadge();

            const successModal = document.getElementById('success-modal');
            successModal.classList.remove('hidden');
            successModal.classList.add('flex');
            lucide.createIcons();
        }

        function closeSuccessModal() {
            const successModal = document.getElementById('success-modal');
            successModal.classList.remove('flex');
            successModal.classList.add('hidden');
        }

        // Mobile Menu Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }
    </script>
</body>
</html>
